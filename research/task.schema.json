{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research task v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "kind",
    "depends_on",
    "resource",
    "executor",
    "attempts",
    "timeout_s",
    "description"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "kind": {
      "enum": [
        "statistics",
        "compute",
        "recovery"
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "uniqueItems": true,
      "maxItems": 32
    },
    "resource": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "executor": {
      "enum": [
        "auto",
        "fixture",
        "dsh",
        "codex"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "timeout_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
