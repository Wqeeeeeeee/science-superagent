{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "task_id",
    "attempt",
    "kind",
    "evidence"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "kind": {
      "enum": [
        "statistics",
        "compute",
        "recovery"
      ]
    },
    "evidence": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "total",
            "mean_milli"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "total": {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            },
            "mean_milli": {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "normalizer"
          ],
          "properties": {
            "normalizer": {
              "enum": [
                "decimal-v1"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    }
  }
}
